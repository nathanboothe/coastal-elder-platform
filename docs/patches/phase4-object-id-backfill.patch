+// --- One-time M365 Object ID backfill for elders seeded before this app
+// tracked Object IDs (Source = 'Manual'). Run this — and confirm it
+// reports zero remaining unmatched elders you expect to match — BEFORE
+// ever relying on /elder-sync/refresh above for those same elders, or
+// refresh will create duplicate records for them. See
+// lib/elderObjectIdBackfill.js for why. Defaults to a dry run (report
+// only, nothing written); pass { "confirm": true } in the request body
+// to actually write the matched Object IDs to Airtable. ---
+
+router.post('/elder-sync/backfill-object-ids', manageAuth.requireAdminAuth, async (req, res, next) => {
+  try {
+    if (req.auth.role !== 'admin') {
+      return res.status(403).json({ error: 'Only admins can run the M365 Object ID backfill.' });
+    }
+    const confirm = req.body && req.body.confirm === true;
+    const report = await elderObjectIdBackfill.backfillObjectIds({ confirm });
+    res.json({ success: true, ...report });
+  } catch (err) {
+    next(err);
+  }
+});
+
